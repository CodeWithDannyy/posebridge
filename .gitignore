# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Data and models: large binaries, recreated by scripts ---
/data/
/models/

# --- Unity: generated by the editor, rebuilt when the project opens ---
/unity/*/[Ll]ibrary/
/unity/*/[Tt]emp/
/unity/*/[Oo]bj/
/unity/*/[Bb]uild/
/unity/*/[Bb]uilds/
/unity/*/[Ll]ogs/
/unity/*/[Uu]ser[Ss]ettings/
/unity/*/*.csproj
/unity/*/*.sln
/unity/*/*.slnx
/unity/*/Assets/_Recovery/
/unity/*/Assets/_Recovery.meta
# Mixamo character files are downloaded by each user (see README), not redistributed.
# Their .meta files ARE committed, so import settings and scene references survive.
/unity/*/Assets/Characters/**/*.fbx
/unity/*/Assets/Characters/**/*.FBX
/unity/*/.vs/

# --- OS / editor clutter ---
Thumbs.db
desktop.ini
.vscode/
